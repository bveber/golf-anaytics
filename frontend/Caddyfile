{$DOMAIN:localhost} {
	# Automatic HTTPS can't work for this domain: ACME challenges must reach
	# DOMAIN's public DNS answer, which points at API Gateway (so the domain
	# stays stable across the EC2 instance's changing IP), not this instance.
	# Use the self-signed cert Terraform provisions instead - the gateway
	# Lambda pins this exact cert rather than trusting a public CA for it.
	tls /certs/origin.crt /certs/origin.key

	# Both branches must be wrapped in handle blocks (mutually exclusive,
	# first match wins) - a bare top-level file_server sits ahead of handle
	# in Caddy's canonical directive order, so it intercepted every non-
	# GET/HEAD request (including POST /api/*) before routing ever ran,
	# rejecting them with 405 regardless of path.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
